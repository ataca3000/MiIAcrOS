# Variables de entorno requeridas para Karen AI
# Copia este archivo como .env y rellena los valores

# === Gemini API ===
# Obtén tu clave en https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# === Backend WebSocket ===
# URL del servidor Python backend (por defecto: localhost:8765)
VITE_BACKEND_URL=ws://localhost:8765

# === Configuración de la aplicación ===
# Modelo de IA por defecto: gemini | llama3 | mistral
DEFAULT_AI_MODEL=gemini

# Puerto del servidor de desarrollo Vite
PORT=3000
